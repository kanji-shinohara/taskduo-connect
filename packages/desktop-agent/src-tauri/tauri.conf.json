{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "task-duo-agent",
  "version": "0.1.0",
  "identifier": "com.taskduo.agent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TaskDuo Agent Settings",
        "width": 560,
        "height": 520,
        "resizable": false,
        "fullscreen": false,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self' tauri: customprotocol:; connect-src 'self' http://localhost:* http://127.0.0.1:* https://*.ts.net:*; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
